Options All -Indexes
Options -MultiViews

RewriteEngine On

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [QSA,L]

# No cachear respuestas PHP (HTML dinámico del CMS)
<FilesMatch "\.(php|php5|php4|php3)$">
	<IfModule mod_headers.c>
		Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
	</IfModule>
</FilesMatch>

# Cachear activos estáticos con checksum ETag: máxima velocidad en visitas repetidas
<IfModule mod_headers.c>
	<FilesMatch "\.(js|mjs|css|json|xml|txt)$">
		Header set Cache-Control "public, max-age=2592000"
		Header unset Pragma
	</FilesMatch>
	<FilesMatch "\.(png|jpe?g|gif|svg|ico|webp|avif|woff2?|ttf|otf|eot|bmp)$">
		# 30 días de caché; se revalida por ETag si el archivo cambió
		Header set Cache-Control "public, max-age=2592000"
		Header unset Pragma
	</FilesMatch>
	<FilesMatch "\.(gif|jpe?g|png|svg|ico|webp|avif|woff2?|ttf|otf|eot|bmp)$">
		Header set X-Content-Type-Options "nosniff"
	</FilesMatch>
</IfModule>

# Compresión gzip para textos (si no la gestiona el vhost)
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

AddHandler application/x-httpd-php80 .php .php5 .php4 .php3